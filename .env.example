# ==============================================================================
# TravelWise Environment Configuration Template
# Copy this file to `.env` and fill in your actual credentials.
# Note: NEVER commit the actual `.env` file to version control.
# ==============================================================================

# --- PostgreSQL Database Credentials ---
# For local development with PostgreSQL installed on Windows / Linux / macOS:
# 1. Start your PostgreSQL service.
# 2. In psql or pgAdmin, run: CREATE DATABASE travelwise_db;
# 3. Enter your PostgreSQL user and password below.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travelwise_db
DB_USER=postgres
DB_PASSWORD=change_me_in_dotenv

# Optional full connection URL (overrides individual DB_* fields if set):
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/travelwise_db

# --- External API Configuration ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- PySpark & Application Settings ---
SPARK_APP_NAME=TravelWise_ETL
LOG_LEVEL=INFO
