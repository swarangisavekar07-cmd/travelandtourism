# ==============================================================================
# TravelWise - Git Ignore Configuration
# ==============================================================================

# 1. Environment & Credentials (CRITICAL - NEVER UPLOAD)
.env
.env.local
.env.development
.env.test
.env.production
*.env
*.key
*.pem

# Allow environment templates
!.env.example
!*.env.example

# 2. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
*.log

# 4. IDE, Editor & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 5. Bulky Raw Reference Files & Local Spreadsheets
# (Excludes heavy government compendium PDFs, DOCs, backups, and raw weather payload dumps)
*.pdf
*.doc
*.docx
*.bak
*.xlsx
data/raw/weather_*.json

# Retain essential raw tourism CSV & metadata
!data/raw/tourism/india_tourism_statewise_2018_2022.csv
!data/raw/tourism/metadata_india_tourism_statewise_2018_2022.json
!data/raw/tourism/metadata_india_tourism_statewise_2018_2022.md

# (Curated Parquet datasets in data/processed/ are retained so Streamlit runs immediately)
!data/processed/**
